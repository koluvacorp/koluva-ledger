{
  "name": "koluva-ledger",
  "productName": "Koluva Ledger",
  "version": "1.2.2",
  "description": "Autogestión financiera local para Windows y Android.",
  "author": "Koluva",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "sync": "node tools/sync-www.cjs",
    "start": "node tools/sync-www.cjs && electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "node tools/sync-www.cjs && electron-builder --win nsis --x64",
    "android:sync": "node tools/sync-www.cjs && cap sync android",
    "release:manifest": "node tools/create-update-manifest.cjs",
    "release:publish": "node tools/publish.cjs"
  },
  "engines": { "node": ">=24.0.0" },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.koluva.ledger",
    "productName": "Koluva Ledger",
    "artifactName": "KoluvaLedger-${version}-Windows-${arch}-Setup.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**/*", "www/**/*", "release.config.json", "package.json"],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": { "target": "nsis", "icon": "www/assets/app-icon.png", "executableName": "KoluvaLedger" },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowElevation": false, "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true,
      "shortcutName": "Koluva Ledger", "deleteAppDataOnUninstall": false,
      "installerLanguages": ["es", "en", "fr", "pt_BR"], "language": "3082"
    }
  }
}
