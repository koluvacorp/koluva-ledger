<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_ledger_bg">
    <TextView android:id="@+id/lw_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lw_muted" android:textSize="12sp"/>
    <TextView android:id="@+id/lw_big" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lw_ink" android:textSize="26sp" android:textStyle="bold" android:singleLine="true"/>
    <TextView android:id="@+id/lw_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/lw_muted" android:textSize="12sp" android:singleLine="true"/>
    <LinearLayout android:id="@+id/lw_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/lw_when1" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/lw_red" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/lw_text1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/lw_ink" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/lw_amt1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lw_muted" android:textSize="12sp" android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lw_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/lw_when2" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/lw_red" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/lw_text2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/lw_ink" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/lw_amt2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lw_muted" android:textSize="12sp" android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/lw_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/lw_when3" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/lw_red" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/lw_text3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/lw_ink" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/lw_amt3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/lw_muted" android:textSize="12sp" android:singleLine="true"/>
    </LinearLayout>
    <TextView android:id="@+id/lw_none" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/lw_muted" android:textSize="12sp"/>
</LinearLayout>
